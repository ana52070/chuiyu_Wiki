{
	"nodes":[
		{"id":"ca5dde5a7f3876ea","type":"group","x":-275,"y":-180,"width":320,"height":1180,"color":"1","label":"main()"},
		{"id":"cf2d230467740d23","type":"group","x":120,"y":280,"width":350,"height":1000,"color":"1","label":"pipeline.start(config);"},
		{"id":"413eade407f538a1","x":1060,"y":185,"width":400,"height":680,"color":"1","type":"group","label":"runtime_.load(config.model_path)"},
		{"id":"5cdda864c5c8cbc0","type":"group","x":600,"y":280,"width":360,"height":490,"color":"1","label":"detector.load(config.yolo)"},
		{"id":"63346a5eb8a7eca9","type":"text","text":"判断接受参数","x":-240,"y":-160,"width":250,"height":60},
		{"id":"f1304ded8e7e629b","type":"text","text":"创建YoloTask对象：task","x":-240,"y":-60,"width":250,"height":60},
		{"id":"801b92f07560b0da","type":"text","text":"判断传入参数Task_name\n填入task对象参数类型HBB/OBB","x":-255,"y":40,"width":280,"height":60},
		{"id":"49742670dc23066e","type":"text","text":"**\n配置config 内容\n**\n\n```\n    config.rtsp_url = argv[2]; //RTSP链接\n    config.warmup_frames = 30; \n    //预热帧数。管线启动后会先跑 30 帧做\"预热\"(加载 RKNN、缓存、让解码/推理进入稳定状态),这些帧不纳入统计,避免前几帧的延迟偏高影响测量结果。\n\n    config.max_inference_frames = 300;\n    //最大推理帧数。跑到 300 帧后管线自动停止(打印统计后退出)。这是测试用的\"跑多久\"限制,默认 `0` 表示一直运行。\n\n  \n\n    config.yolo.model_path = argv[1];\n    //RKNN 模型文件路径\n\n    config.yolo.version = YoloVersion::YOLOv11;\n    //模型版本。告诉解码器按 YOLOv11 的输出格式解释\n    \n\n    config.yolo.task = task;\n    //检测任务类型:OBB/HBB\n\n    config.yolo.output_type = YoloOutputType::NoHead;\n    //模型输出是否包含检测 head\n\n    config.yolo.schema = YoloOutputSchema::Auto;\n\t//模型输出的张量布局格式(输出 tensor 的组织方式)\n\t\n    config.yolo.reg_max = 16;\n    //DFL(距离拟合损失)的最大回归值。YOLOv8/v11 的 box 坐标用 DFL 把连续回归离散成 `reg_max` 个 bin,默认是 16。对特殊导出的模型可覆盖。它决定了解码时每个 box 维度的长度。\n\n    config.yolo.confidence_threshold = threshold;\n    //置信度阈值。得分低于此值的检测框会被丢弃(命令行第 5 个可选参数,默认 `0.25`)。控制\"多敏感\",越低检出越多但误检也越多。\n\n  \n\n    config.yolo.nms_threshold =\n        task == YoloTask::OBB\n\n        ? 0.10f\n\n        : 0.45f;\n     //NMS(非极大值抑制)阈值。用于去除重叠检测框。\"我\"和\"你\"两个框如果 IoU 超过这个阈值,就只保留得分高那个。\n```","x":-255,"y":240,"width":280,"height":60},
		{"id":"b85f26f0dfe84366","type":"text","text":"创建RealtimePipelineConfig 结构体数据 config","x":-255,"y":140,"width":280,"height":60},
		{"id":"e2568e5a2f549958","type":"text","text":"创建RealtimeVisionPipeline 对象 pipeline","x":-255,"y":340,"width":280,"height":60},
		{"id":"52b3c1140ef83557","type":"text","text":"判断 start是否开始\n判断 rtsp链接是否为空","x":165,"y":310,"width":250,"height":60},
		{"id":"88f069ec9a559879","type":"text","text":"加载模型路径、创建模型缓存","x":1100,"y":205,"width":320,"height":60},
		{"id":"053942c0e8a0e1ec","type":"text","text":"rknn_init()，创建context","x":1100,"y":295,"width":320,"height":60,"color":"1"},
		{"id":"9ba50d643c38cc3c","type":"text","text":"接受完整的config结构体参数\n存pipeline对象中的config","x":160,"y":400,"width":260,"height":60},
		{"id":"acdbcd2ad338f4fd","type":"text","text":"callback_ = std::move(callback);\n//回调注册","x":145,"y":500,"width":290,"height":60,"color":"1"},
		{"id":"7123bec48177438d","type":"text","text":"查询 RKNN Runtime 和 NPU driver 版本\nret = rknn_query(）","x":1080,"y":400,"width":360,"height":60,"color":"1"},
		{"id":"a4973c76f857b0dc","type":"text","text":"结果保存到impl_\nimpl_->model_info.sdk_version = sdk_version.api_version;\nimpl_->model_info.driver_version = sdk_version.drv_version;","x":1080,"y":490,"width":360,"height":60},
		{"id":"82fc3ee158243950","type":"text","text":"查询模型有几个 input 和 output\nret = rknn_query()","x":1080,"y":595,"width":360,"height":60,"color":"1"},
		{"id":"3b71d924ea2e6c53","type":"text","text":"查询所有 input tensor。","x":1080,"y":685,"width":360,"height":60},
		{"id":"9185dbb610905cbc","type":"text","text":"查询所有 output tensor。","x":1080,"y":780,"width":360,"height":60},
		{"id":"70b2fb1e4f80a6c1","type":"text","text":"runtime_.load(config.model_path)\n//rknn加载模型","x":620,"y":300,"width":320,"height":60,"color":"1"},
		{"id":"87abf3b99758a608","type":"text","text":"runtime_.setCore(config.core)\n//rknn设置核心","x":620,"y":390,"width":320,"height":60,"color":"1"},
		{"id":"514005ec8612a776","type":"text","text":"YoloModelConfig config传入 YoloDetector 对象中的config_","x":620,"y":490,"width":320,"height":60},
		{"id":"69eb99780b3ab7e0","type":"text","text":"YoloModelInspector::inspect config_,\nruntime_.modelInfo(),\ndescriptor_,\nerror//识别模型输出结构\n","x":620,"y":590,"width":320,"height":130,"color":"1"},
		{"id":"c6ec71d23f81ba39","type":"text","text":"detector_.load(config_.yolo)\n//加载模型","x":145,"y":600,"width":290,"height":60,"color":"1"},
		{"id":"ed66be1d3af3669b","type":"text","text":"detector_.prepareZeroCopyIO(config_.padding_value)\n//准备零拷贝","x":145,"y":690,"width":290,"height":80,"color":"1"},
		{"id":"99061044945cbf1c","type":"text","text":"input_ = detector_.zeroCopyInputBuffer();\n//创建零拷贝Buffer","x":145,"y":800,"width":290,"height":80,"color":"1"},
		{"id":"c62b016e7db99495","type":"text","text":"source_.open(config_.rtsp_url)\n//打开rtsp地址，寻找视频流","x":145,"y":920,"width":290,"height":80,"color":"1"},
		{"id":"eb6ac48ca9e8a028","type":"text","text":"decoder_.open(source_.codec())\n//初始化MPP解码器","x":145,"y":1040,"width":290,"height":80,"color":"1"},
		{"id":"6d3230b2c2e5b66b","type":"text","text":"计时器相关\n    stop_requested_.store(false);\n\n    failed_.store(false);\n\n    packet_count_.store(0);\n\n    decoded_count_.store(0);\n\n    inference_count_.store(0);\n\n  \n\n    start_time_ = Clock::now();\n\n    started_ = true;\n\n    running_.store(true);\n\n  \n\n    producer_thread_ =\n\n        std::thread(\n\n            &RealtimeVisionPipeline::producerLoop,\n\n            this);\n\n  \n\n    consumer_thread_ =\n\n        std::thread(\n\n            &RealtimeVisionPipeline::consumerLoop,\n\n            this);","x":145,"y":1160,"width":290,"height":80,"color":"1"},
		{"id":"d66d80bca3b7701b","type":"text","text":"pipeline.start(config);","x":-255,"y":440,"width":280,"height":60,"color":"1"},
		{"id":"7eac74c8d7cb7c04","type":"text","text":"pipeline.wait();","x":-255,"y":530,"width":280,"height":60,"color":"1"}
	],
